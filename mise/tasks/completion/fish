#!/usr/bin/env bash
#MISE description="Run the fish completion integration tests in containers"
#MISE depends=["completion:build-linux"]
set -euo pipefail

tests=()
for dockerfile in completion-integrations/tests/Dockerfile.*fish*; do
  tests+=("${dockerfile##*/Dockerfile.}")
done

exec completion-integrations/src/test-all.sh "${tests[@]}"
